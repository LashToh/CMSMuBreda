# =============================================================================
# MU BREDA SEASON 21 CMS — Environment Variables
# Copy to `.env` for local development. Never commit real credentials.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
# mock | production — mock NEVER activates when NODE_ENV=production
MU_DATABASE_MODE=mock

# --- SQL Server (required when MU_DATABASE_MODE=production) ---
DB_HOST=127.0.0.1
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=CHANGE_ME
DB_DATABASE=MuOnline
DB_ENCRYPT=false
DB_TRUST_CERT=true
# Optional second DB (accounts / CMS tables). Leave empty for single-DB.
DB_DATABASE_2=

# --- API ---
API_PORT=3001
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
TRUST_PROXY=1

# --- Auth / JWT ---
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
COOKIE_NAME=mubreda_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Password hashing (must match JoinServer) ---
# Options: plain | md5 | wz_md5 | sha256
HASH_METHOD=md5
# Required only when HASH_METHOD=sha256
SHA256_SALT=

# --- Registration ---
DEFAULT_SNO_NUMB=1111111111111
INSERT_VI_CURR_INFO=false
ALLOW_DUPLICATE_EMAILS=false

# --- Rate limits ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=5

# --- Server info (public) ---
SERVER_NAME=MU Breda
SERVER_SEASON=21
SERVER_EXP=9999x
SERVER_MASTER_EXP=9999x
SERVER_DROP=50%
SERVER_MAX_LEVEL=1750
SERVER_MAX_MASTER_LEVEL=400
RESET_LEVEL=400
DISCORD_URL=https://discord.gg/SV6yW7XK7
DOWNLOAD_URL=https://your-cdn.example.com/MU-Client.zip
INSTAGRAM_URL=https://www.instagram.com/mubredaonline/
FACEBOOK_URL=https://www.facebook.com/mubredaonline

# --- Feature flags (dangerous / unverified modules default OFF) ---
ENABLE_WEBSHOP=true
ENABLE_WEBSHOP_DELIVERY=false
ENABLE_RESET=false
ENABLE_GRAND_RESET=false
ENABLE_CLEAR_PK=false
ENABLE_UNSTUCK=false
ENABLE_VIP=false
ENABLE_GIFT_CODES=true
ENABLE_VOTE_REWARDS=false
ENABLE_NEWS=true
ENABLE_DOWNLOADS=true
ENABLE_RANKINGS=true
ENABLE_DONATIONS=true

# --- Donations (Mercado Pago / Stripe / PayPal → WCoinC) ---
# Mock mode auto-on when MU_DATABASE_MODE=mock; set DONATIONS_MOCK=false to force live providers in dev.
DONATIONS_MOCK=true
DONATIONS_PUBLIC_BASE_URL=http://localhost:5173
DONATIONS_SUCCESS_URL=http://localhost:5173/donate?status=success
DONATIONS_CANCEL_URL=http://localhost:5173/donate?status=cancel

# Mercado Pago
MP_ENABLED=true
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_DESCRIPTION=MU Breda donation

# Stripe
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# PayPal (classic IPN)
PAYPAL_ENABLED=true
PAYPAL_SANDBOX=true
PAYPAL_EMAIL=
PAYPAL_TITLE=Donation for WCoinC
PAYPAL_CURRENCY=USD
PAYPAL_RETURN_URL=http://localhost:5173/donate?status=paypal
PAYPAL_NOTIFY_URL=http://localhost:3001/api/donations/webhooks/paypal
PAYPAL_CONVERSION_RATE=100

# --- MU table / column mappings (override when schema differs) ---
MU_TABLE_ACCOUNTS=MEMB_INFO
MU_COL_USERNAME=memb___id
MU_COL_PASSWORD=memb__pwd
MU_COL_EMAIL=mail_addr
MU_COL_BLOC=bloc_code
MU_COL_GUID=memb_guid
MU_TABLE_CHARACTERS=Character
MU_COL_CHAR_NAME=Name
MU_COL_CHAR_ACCOUNT=AccountID
MU_COL_CHAR_CLASS=Class
MU_COL_CHAR_LEVEL=cLevel
MU_COL_CHAR_RESETS=RESETS
MU_COL_CHAR_GRAND_RESETS=GrandResets
MU_COL_CHAR_MASTER_LEVEL=mLevel
MU_COL_CHAR_PK_LEVEL=PkLevel
MU_COL_CHAR_PK_COUNT=PkCount
MU_COL_CHAR_MAP=MapNumber
MU_COL_CHAR_POS_X=MapPosX
MU_COL_CHAR_POS_Y=MapPosY
MU_TABLE_MEMB_STAT=MEMB_STAT
MU_COL_CONNECT_STAT=ConnectStat
MU_TABLE_GUILD=Guild
MU_TABLE_GUILD_MEMBER=GuildMember

# Currency mappings (empty = disabled / mock defaults)
CURRENCY_CREDITS_TABLE=MEMB_CREDITS
CURRENCY_CREDITS_COLUMN=credits
CURRENCY_CREDITS_USER_COLUMN=memb___id
CURRENCY_WCOINC_TABLE=
CURRENCY_WCOINC_COLUMN=WCoinC
CURRENCY_WCOINC_USER_COLUMN=AccountID
CURRENCY_WCOINP_TABLE=
CURRENCY_WCOINP_COLUMN=WCoinP
CURRENCY_WCOINP_USER_COLUMN=AccountID
CURRENCY_GOBLIN_TABLE=
CURRENCY_GOBLIN_COLUMN=GoblinPoint
CURRENCY_GOBLIN_USER_COLUMN=AccountID

# VIP mapping
VIP_TABLE=T_VIPList
VIP_USER_COLUMN=AccountID
VIP_TYPE_COLUMN=Type
VIP_DATE_COLUMN=Date

# Character tools defaults (verify before enabling)
UNSTUCK_MAP=0
UNSTUCK_X=125
UNSTUCK_Y=125
CLEAR_PK_LEVEL=3

# Admin usernames (comma-separated). Backend-enforced.
ADMIN_USERNAMES=admin

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3001
VITE_DOWNLOAD_URL=https://your-cdn.example.com/MU-Client.zip
VITE_DISCORD_URL=https://discord.gg/SV6yW7XK7
VITE_INSTAGRAM_URL=https://www.instagram.com/mubredaonline/
VITE_FACEBOOK_URL=https://www.facebook.com/mubredaonline
VITE_SERVER_NAME=MU Breda
VITE_SERVER_SEASON=21
