# =============================================================================
# PRODUCTION — Frontend (Vite build-time variables)
# Copy to .env.production before `npm run build`.
# =============================================================================

VITE_API_URL=https://api.yourdomain.com
VITE_DOWNLOAD_URL=https://cdn.yourdomain.com/MU-Client.zip
VITE_DISCORD_URL=https://discord.gg/SV6yW7XK7
VITE_INSTAGRAM_URL=https://www.instagram.com/mubredaonline/
VITE_FACEBOOK_URL=https://www.facebook.com/mubredaonline/
VITE_SERVER_NAME=MU Breda
VITE_SERVER_SEASON=21

# =============================================================================
# PRODUCTION — Backend API runtime (copy to server `.env`)
# Never commit real secrets.
# =============================================================================

NODE_ENV=production
# mock is FORBIDDEN in production — config forces production mode
MU_DATABASE_MODE=production

DB_HOST=YOUR_SQL_SERVER_IP
DB_PORT=1433
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_DATABASE=MuOnline
DB_DATABASE_2=
DB_ENCRYPT=false
DB_TRUST_CERT=true

API_PORT=3001
PORT=3001
CORS_ORIGIN=https://yourdomain.com
TRUST_PROXY=1

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
COOKIE_NAME=mubreda_session
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

HASH_METHOD=md5
SHA256_SALT=
DEFAULT_SNO_NUMB=1111111111111
INSERT_VI_CURR_INFO=false
ALLOW_DUPLICATE_EMAILS=false

ADMIN_USERNAMES=admin

ENABLE_WEBSHOP=true
ENABLE_WEBSHOP_DELIVERY=false
ENABLE_RESET=false
ENABLE_GRAND_RESET=false
ENABLE_CLEAR_PK=false
ENABLE_UNSTUCK=false
ENABLE_VIP=false
ENABLE_GIFT_CODES=true
ENABLE_VOTE_REWARDS=false
ENABLE_NEWS=true
ENABLE_DOWNLOADS=true
ENABLE_RANKINGS=true

SERVER_NAME=MU Breda
SERVER_SEASON=21
SERVER_EXP=9999x
SERVER_MASTER_EXP=9999x
SERVER_DROP=50%
SERVER_MAX_LEVEL=1750
SERVER_MAX_MASTER_LEVEL=400
RESET_LEVEL=400
DISCORD_URL=https://discord.gg/SV6yW7XK7
DOWNLOAD_URL=https://cdn.yourdomain.com/MU-Client.zip
