# =============================================================================
# PRODUCTION — Frontend (Vite build-time variables)
# Copy to .env.production before `npm run build`.
# =============================================================================

# Leave empty for same-origin (one Node app serves site + /api)
# Split deploy / beta front → API on VPS:
# VITE_API_URL=https://api.mubreda.net
VITE_API_URL=
VITE_DOWNLOAD_URL=https://cdn.yourdomain.com/MU-Client.zip
VITE_DISCORD_URL=https://discord.gg/SV6yW7XK7
VITE_INSTAGRAM_URL=https://www.instagram.com/mubredaonline/
VITE_FACEBOOK_URL=https://www.facebook.com/mubredaonline/
VITE_SERVER_NAME=MU Breda
VITE_SERVER_SEASON=21

# =============================================================================
# PRODUCTION — Backend API runtime (copy to server `.env` on the VPS)
# Never commit real secrets. See docs/VPS.md for api.mubreda.net (API-only).
# =============================================================================

NODE_ENV=production
# mock is FORBIDDEN in production — config forces production mode
MU_DATABASE_MODE=production

DB_HOST=YOUR_SQL_SERVER_IP
DB_PORT=1433
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_DATABASE=MuOnline
DB_DATABASE_2=
DB_ENCRYPT=false
DB_TRUST_CERT=true

# --- API-only block (api.mubreda.net) — site NOT served from this Node process ---
API_PORT=3001
PORT=3001
SERVE_SPA=false
CORS_ORIGIN=https://mubreda.net,https://www.mubreda.net
TRUST_PROXY=1
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=.mubreda.net
DONATIONS_PUBLIC_BASE_URL=https://mubreda.net
DONATIONS_WEBHOOK_BASE_URL=https://api.mubreda.net
PUBLIC_BASE_URL=https://mubreda.net

# AstroPay (AdminCP → Integrations also writes these)
ASTROPAY_ENABLED=true
ASTROPAY_API_KEY=
ASTROPAY_API_SECRET=
ASTROPAY_SANDBOX=true
ASTROPAY_COUNTRY=AR

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
COOKIE_NAME=mubreda_session

HASH_METHOD=md5
SHA256_SALT=
DEFAULT_SNO_NUMB=1111111111111
INSERT_VI_CURR_INFO=false
ALLOW_DUPLICATE_EMAILS=false

ADMIN_USERNAMES=admin

ENABLE_WEBSHOP=true
ENABLE_WEBSHOP_DELIVERY=false
ENABLE_RESET=false
ENABLE_GRAND_RESET=false
ENABLE_CLEAR_PK=false
ENABLE_UNSTUCK=false
ENABLE_VIP=false
ENABLE_GIFT_CODES=true
ENABLE_VOTE_REWARDS=false
ENABLE_NEWS=true
ENABLE_DOWNLOADS=true
ENABLE_RANKINGS=true

SERVER_NAME=MU Breda
SERVER_SEASON=21
SERVER_EXP=9999x
SERVER_MASTER_EXP=9999x
SERVER_DROP=50%
SERVER_MAX_LEVEL=1750
SERVER_MAX_MASTER_LEVEL=400
RESET_LEVEL=400
DISCORD_URL=https://discord.gg/SV6yW7XK7
DOWNLOAD_URL=https://cdn.yourdomain.com/MU-Client.zip
# GameServer status (TCP) + players from MEMB_STAT ConnectStat=1
GS_HOST=YOUR_GAMESERVER_IP
GS_PORT=55901
GS_CHECK_TIMEOUT_MS=1500
